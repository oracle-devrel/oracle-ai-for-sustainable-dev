# Oracle Database Configuration
DB_USERNAME=FINANCIAL
DB_PASSWORD=your_database_password_here
DB_USERNAME_NA=SUPPLYCHAIN_NA_MGR
DB_PASSWORD_NA=your_na_manager_password_here
DB_USERNAME_APAC=SUPPLYCHAIN_APAC_MGR
DB_PASSWORD_APAC=your_apac_manager_password_here
# Backward-compatible restricted-user secret; the regional setup script uses
# it only as a local fallback when the two distinct passwords are omitted.
DB_PASSWORD2=your_restricted_end_user_password_here
DB_ADMIN_USERNAME=ADMIN
DB_ADMIN_PASSWORD=your_admin_password_here
DB_DSN=paulparkdb_tp
DB_WALLET_PASSWORD=your_wallet_password_here
DB_WALLET_DIR=/home/ssh-key-2025-10-20/wallet-paulparkdb-20260808
TNS_ADMIN=/home/ssh-key-2025-10-20/wallet-paulparkdb-20260808

# Schema and database-managed Select AI agent configuration.
# Set all three owners to the schema that actually contains the SC_* objects.
DB_SCHEMA_OWNER=FINANCIAL
INVENTORY_SCHEMA_OWNER=FINANCIAL
SELECT_AI_OBJECT_OWNER=FINANCIAL
SELECT_AI_PROFILE=PAULPARK_SUPPLY_CHAIN_OPENAI
DBMS_CLOUD_AI_PROFILE=PAULPARK_SUPPLY_CHAIN_OPENAI
SELECT_AI_PROVIDER=openai
SELECT_AI_CREDENTIAL_NAME=OPENAI_CRED
SELECT_AI_MODEL=gpt-4o-mini
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
SELECT_AI_OPENAI_CREDENTIAL_NAME=OPENAI_CRED
SELECT_AI_OPENAI_PROFILE=PAULPARK_SUPPLY_CHAIN_OPENAI
SELECT_AI_OPENAI_MODEL=gpt-4o-mini
SELECT_AI_PROMPT_SCOPE=inventory-demo
INVENTORY_SYSTEM_SELECT_AI_SCOPE=inventory-demo
INVENTORY_SYSTEM_ALLOW_LOCAL_SELECT_AI_FALLBACK=false

# Google Cloud Platform Configuration
GCP_PROJECT_ID=adb-pm-prod
GCP_REGION=us-east4
GCP_ZONE=us-east4-a
GCP_VM_NAME=paulpark-instance

# Public A2A gateway served from the shared VM.
PUBLIC_PROTOCOL=https
PUBLIC_HOST=34.48.146.146
GRAPH_AGENT_PORT=8443
BIND_HOST=0.0.0.0
A2A_URL=https://34.48.146.146:8443
GRAPH_AGENT_URL=https://34.48.146.146:8443/graph

# Oracle-managed A2A database agent. Obtain client credentials from the
# paulparkdb registration endpoint; keep the real values only in .env/Secret Manager.
ORACLE_AI_DATABASE_AGENT_URL=https://dataaccess.adb.us-ashburn-1.oraclecloudapps.com/adb/a2a/v1/agents/oracle_ai_database_agent
ORACLE_AI_DATABASE_AGENT_AUTHORIZATION_URL=https://dataaccess.adb.us-ashburn-1.oraclecloudapps.com/adb/auth/v1/connect/authorize
ORACLE_AI_DATABASE_AGENT_TOKEN_URL=https://dataaccess.adb.us-ashburn-1.oraclecloudapps.com/adb/auth/v1/connect/token
ORACLE_AI_DATABASE_AGENT_CLIENT_ID=your_oracle_a2a_client_id
ORACLE_AI_DATABASE_AGENT_CLIENT_SECRET=your_oracle_a2a_client_secret
ORACLE_AI_DATABASE_AGENT_REFRESH_TOKEN=your_oracle_a2a_refresh_token
ORACLE_AI_DATABASE_AGENT_TIMEOUT_SECONDS=90

# Application Ports
# Port for Streamlit UI (rag_app_ui.py)
STREAMLIT_PORT=8501

# Port for FastAPI RAG API (oracle_ai_database_rag.py)
API_PORT=8501

# Oracle RAG API URL for ADK Agent (oracle_ai_database_adk_agent.py)
# This is where the agent will call the RAG API
# 
# Use localhost when agent runs on SAME machine as API server:
ORACLE_RAG_API_URL=http://localhost:8501
#
# Use IP/hostname when agent runs on DIFFERENT machine than API server:
# ORACLE_RAG_API_URL=http://34.48.146.146:8501
# ORACLE_RAG_API_URL=http://your-gcp-vm-ip:8501

# SQLcl and MCP Configuration (for oracle_ai_database_adk_agent.py)
SQLCL_PATH=/opt/sqlcl/bin/sql
# MCP Connection name in SQLcl: paulparkdb_mcp
# Create with: sql /nolog
#              conn -save paulparkdb_mcp -savepwd ADMIN/password@paulparkdb_tp

# Gemini CLI / Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=adb-pm-prod
GOOGLE_CLOUD_LOCATION=us-east4

# Oracle Database Configuration for Gemini CLI oracledb extension
# (https://github.com/gemini-cli-extensions/oracledb)
ORACLE_USER=FINANCIAL
ORACLE_PASSWORD=your_database_password_here
ORACLE_TNS_ALIAS=paulparkdb_tp
ORACLE_TNS_ADMIN=/home/ssh-key-2025-10-20/wallet-paulparkdb-20260808
ORACLE_WALLET=/home/ssh-key-2025-10-20/wallet-paulparkdb-20260808
