# Copy to memory/.env only if you do not want to reuse financial/setup/.env.
# Never commit a real password or wallet.
DB_SERVICE=financialdb_high
DB_USERNAME=FINANCIAL
DB_PASSWORD=replace-me
DDS_ADMIN_PASSWORD=only-needed-by-memory/deep-data-security/bootstrap.py
DDS_AVA_PASSWORD=use-an-individually-managed-demo-password
DDS_LEO_PASSWORD=use-an-individually-managed-demo-password
TNS_ADMIN=/absolute/path/to/Wallet_financialdb
DB_URL=jdbc:oracle:thin:@financialdb_high?TNS_ADMIN=/absolute/path/to/Wallet_financialdb
MEMORY_PORT=8091
MEMORY_PYTHON_PORT=8092
