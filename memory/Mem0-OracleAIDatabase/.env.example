# Required Oracle Database connection settings
ORACLE_USER=mem0_user
ORACLE_PASSWORD=replace-me
ORACLE_DSN=localhost:1521/FREEPDB1

# Optional wallet settings for Autonomous Database
# ORACLE_CONFIG_DIR=/absolute/path/to/wallet
# ORACLE_WALLET_LOCATION=/absolute/path/to/wallet
# ORACLE_WALLET_PASSWORD=replace-if-required

# End-to-end Mem0 extraction and embedding
OPENAI_API_KEY=replace-me
MEM0_LLM_MODEL=gpt-4.1-mini
MEM0_EMBEDDING_MODEL=text-embedding-3-small
MEM0_EMBEDDING_DIMS=1536

# Oracle collection and index
MEM0_ORACLE_COLLECTION=MEM0_ORACLE_MEMORIES
MEM0_CREATE_VECTOR_INDEX=true
MEM0_VECTOR_INDEX_TYPE=HNSW
MEM0_VECTOR_INDEX_ACCURACY=95

