# Local configuration only. Never commit real credentials or wallets.
AGENT_PORT=8080
# Deep Data Security requires Oracle AI Database 26ai.
TNS_ADMIN=/path/to/Wallet_oracle_ai_database_26ai
DB_SERVICE_NAME=replace-with-26ai-service-alias
# Optional override; otherwise DB_URL is built from DB_SERVICE_NAME and TNS_ADMIN.
# DB_URL=jdbc:oracle:thin:@service_alias?TNS_ADMIN=/path/to/Wallet_oracle_ai_database_26ai
DB_USERNAME=FINANCIAL
DB_PASSWORD=replace-me
# Optional ignored file from which load-database-env.sh reads DB_PASSWORD.
# DB_CREDENTIALS_ENV=../../oracle-ai-database-gcp-gemini/.env
# Local Deep Data Security end user used for the restricted read-only demo.
DB_USERNAME2=ENVIRONMENTAL_PLANNER
DB_PASSWORD2=replace-with-a-distinct-local-demo-password
# Required only by setup-deepsec.sh. Keep it out of source control.
DB_ADMIN_USERNAME=ADMIN
DB_ADMIN_PASSWORD=replace-me
DB_POOL_NAME=InteractiveAiFinancialUcpPool
DB_POOL_INITIAL_SIZE=1
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
DB_CONNECTION_WAIT_SECONDS=10
DB_INACTIVE_CONNECTION_SECONDS=60
DB_ROW_PREFETCH=50
# Optional Toolkit build and standalone Streamable HTTP settings.
# ORACLE_MCP_TOOLKIT_JAR=/absolute/path/to/oracle-db-mcp-toolkit-1.0.0.jar
# ORACLE_MCP_CONFIG_FILE=/absolute/path/to/oracle-db-mcp-toolkit/config/tools.yaml
# ORACLE_MCP_URL=https://mcp-toolkit.example.com/mcp
# ORACLE_MCP_AUTH_TOKEN=replace-with-secret-token
# ORACLE_MCP_READ_URL=https://read-only-mcp-toolkit.example.com/mcp
# ORACLE_MCP_READ_AUTH_TOKEN=replace-with-different-secret-token
# ORACLE_MCP_ENABLE_READ_PROFILE=true
# For a private CA, set its PKCS12 truststore. Publicly trusted production TLS needs no override.
# ORACLE_MCP_TRUSTSTORE=/absolute/path/to/truststore.p12
# ORACLE_MCP_TRUSTSTORE_PASSWORD=replace-me
REQUESTED_BY=demo.user@example.com
# Optional MCP App server override; its default is the loopback Java service.
AGENT_SERVICE_URL=http://127.0.0.1:8080
# Optional Gemini Enterprise A2A adapter settings.
GEMINI_ENTERPRISE_A2A_PORT=3002
PUBLIC_A2A_URL=https://replace-with-public-host.example.com
# Developer-only Gemini Enterprise Custom MCP Server OAuth values. Keep real
# values only in the ignored .env; use a secret manager for production.
GEMINI_ENTERPRISE_MCP_OAUTH_CLIENT_ID=replace-with-oauth-client-id
GEMINI_ENTERPRISE_MCP_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
