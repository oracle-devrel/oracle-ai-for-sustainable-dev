FROM maven:3.9.11-eclipse-temurin-21 AS java-build

RUN apt-get update \
    && apt-get install -y --no-install-recommends git patch \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY agent-service ./agent-service
COPY oracle-db-mcp-toolkit ./oracle-db-mcp-toolkit

RUN find agent-service oracle-db-mcp-toolkit \
        -type f \( -name "*.sh" -o -name "*.patch" \) \
        -exec sed -i 's/\r$//' {} + \
    && chmod +x agent-service/prepare-mcp-toolkit.sh \
    && mkdir -p /out \
    && cd agent-service \
    && toolkit_jar="$(./prepare-mcp-toolkit.sh)" \
    && cp "${toolkit_jar}" /out/oracle-db-mcp-toolkit.jar \
    && mvn -q -DskipTests package \
    && cp target/interactive-ai-agent-service-0.1.0-SNAPSHOT.jar \
        /out/interactive-ai-agent-service.jar

FROM node:22.12-bookworm-slim AS mcp-build

WORKDIR /workspace/mcp-app
COPY mcp-app/package.json ./
RUN npm install --no-package-lock --no-audit --no-fund
COPY mcp-app ./
RUN npm run typecheck && npm run build

FROM eclipse-temurin:21-jre-jammy

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app --home-dir /opt/app app

WORKDIR /opt/app

COPY --from=mcp-build /usr/local/bin/node /usr/local/bin/node
COPY --from=mcp-build /workspace/mcp-app ./mcp-app
COPY --from=java-build /out/interactive-ai-agent-service.jar ./
COPY --from=java-build /out/oracle-db-mcp-toolkit.jar ./
COPY oracle-db-mcp-toolkit/config/tools.yaml ./oracle-db-mcp-toolkit/config/tools.yaml
COPY database ./database
COPY web-client ./web-client
COPY deploy/gcp/mcp-app-container-entrypoint.sh /usr/local/bin/mcp-app-container-entrypoint
COPY deploy/gcp/start-toolkit-runtime.sh /usr/local/bin/start-toolkit-runtime

RUN sed -i 's/\r$//' /usr/local/bin/mcp-app-container-entrypoint \
        /usr/local/bin/start-toolkit-runtime \
    && chmod 0555 /usr/local/bin/mcp-app-container-entrypoint \
        /usr/local/bin/start-toolkit-runtime \
    && chown -R app:app /opt/app

ENV AGENT_PORT=8081 \
    AGENT_SERVICE_URL=http://127.0.0.1:8081 \
    DB_POOL_NAME=InteractiveAiChatGptUcpPool \
    DB_SERVICE_NAME=paulparkdb_tp \
    DB_USERNAME=FINANCIAL \
    MCP_BIND_HOST=0.0.0.0 \
    MCP_WRITES_ENABLED=false \
    ORACLE_MCP_CONFIG_FILE=/opt/app/oracle-db-mcp-toolkit/config/tools.yaml \
    ORACLE_MCP_TOOLKIT_JAR=/opt/app/oracle-db-mcp-toolkit.jar \
    PORT=8080 \
    REQUESTED_BY=chatgpt.mcpapp@oracle.com \
    TNS_ADMIN=/tmp/oracle-wallet \
    WALLET_ZIP_FILE=/var/run/secrets/oracle-wallet/wallet.zip

USER app
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/mcp-app-container-entrypoint"]
